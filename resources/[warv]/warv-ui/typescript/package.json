{
  "name": "warv-ui-scripts",
  "private": true,
  "scripts": {
    "build": "npm run clearbuild && node build/build.js",
    "clearbuild": "rimraf ./dist",
    "typecheck": "tsc --noEmit -p client/tsconfig.json",
    "watch": "npm run clearbuild && cross-env IS_WATCH_MODE=1 node build/build.js"
  },
  "devDependencies": {
    "@citizenfx/client": "^2.0.32698-1",
    "@types/node": "^16.18.3",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  }
}
